[Unit]
Description=Rover tick loop
After=network.target

[Service]
Type=notify
WorkingDirectory=/home/rover/rover
ExecStart=/home/rover/rover/.venv/bin/python -m rover.main
ExecStopPost=/home/rover/rover/pi/rover-stop
RuntimeDirectory=rover
WatchdogSec=1
Restart=on-failure
RestartSec=1
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
