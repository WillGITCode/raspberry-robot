#!/bin/bash
# Bench tool: deploy to the Pi, read its logs, show status, stop, drive. Host is the ssh alias rover-bench.
set -euo pipefail
HOST=rover-bench
REMOTE=rover-bench
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
LOCK="$ROOT/.bench/deploy.lock"
PYTHON=${BENCH_PYTHON:-$ROOT/.venv/bin/python}
[ -x "$PYTHON" ] || PYTHON=python3

usage() {
  cat <<'USAGE'
usage: tools/bench [--dry-run] <command>   (--dry-run prints the commands, runs nothing)
  deploy                          pytest, lock, push HEAD, wait for rover.service, print the commit
  logs [--since 2m] [--follow-for 10s]   rover.service and deploy events, bounded
  status                          service state, deployed commit, who deployed
  stop                            stop rover.service, then rover-stop on the Pi (every motor pin low)
  drive <left> <right> <seconds>  feed the drive input for <seconds>, then "0 0" (the service keeps running)
  mode <name> <seconds>           run a mode (explore) for the bench while the pad is idle; the service ends it (stand only)
  snap                            JPEG from the desktop C920 to .bench/snaps/<time>.jpg, prints the path
  clip <seconds>                  MP4 plus a contact-sheet JPEG of its frames, prints both paths
  pad-check                       list evdev devices, then 20 s of live pad readings and mode_change events (read-only)
  ping-check [seconds]            PING))) distances, errors and pin flip times on the Pi (default 10 s; no motion)
  servo-check                     pan servo to 10, 95, 170, then back to 95 (moves the servo only)
  scan-check                      one full ping sweep, 10 to 170 and back, printed per angle (servo only)
  loop-check [seconds]            the whole tick loop from a temporary copy, real ping/servo/status page, MOCK motors
  check-stops                     scripted run on the stand: drive, deadman, kill -9, stop; pass/fail per step (moves the wheels)
USAGE
  exit 2
}

DRY=0
if [ "${1:-}" = --dry-run ]; then DRY=1; shift; fi

# --dry-run prints each command instead of running it
run() { if [ $DRY = 1 ]; then echo "+ $*"; else "$@"; fi; }
remote() { run ssh "$HOST" "$@"; }

cmd_deploy() {
  run "$PYTHON" -m pytest -q "$ROOT"
  if [ $DRY = 1 ]; then
    echo "+ flock -n $LOCK"
    echo "+ git -C $ROOT push $REMOTE HEAD:refs/heads/main"
    echo "+ (up to 30x) ssh $HOST systemctl is-active rover; ssh $HOST journalctl -u rover -o cat -n 20 --no-pager | grep '\"commit\": \"<HEAD>\"'"
    return 0
  fi
  mkdir -p "$(dirname "$LOCK")"
  exec 9>"$LOCK"
  flock -n 9 || { echo "another deploy holds $LOCK" >&2; exit 1; }
  commit=$(git -C "$ROOT" rev-parse HEAD)
  # the hook on the Pi deploys pushes to refs/heads/main
  git -C "$ROOT" push "$REMOTE" HEAD:refs/heads/main
  for _ in $(seq 1 30); do
    if [ "$(remote systemctl is-active rover)" = active ] &&
       remote journalctl -u rover -o cat -n 20 --no-pager | grep -q "\"commit\": \"$commit\""; then
      echo "active, commit $commit"
      return 0
    fi
    sleep 1
  done
  echo "rover.service not active on $commit after 30 s" >&2
  remote systemctl status rover --no-pager >&2 || true
  exit 1
}

cmd_logs() {
  since=2m follow=
  while [ $# -gt 0 ]; do
    case $1 in
      --since) since=$2; shift 2 ;;
      --follow-for) follow=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  if [ -n "$follow" ]; then
    # bounded stream: the Pi-side timeout ends it
    remote timeout "$follow" journalctl -f --since "-$since" -o cat --no-pager _SYSTEMD_UNIT=rover.service + SYSLOG_IDENTIFIER=rover-deploy || [ $? = 124 ]
  else
    remote journalctl --since "-$since" -o cat --no-pager _SYSTEMD_UNIT=rover.service + SYSLOG_IDENTIFIER=rover-deploy
  fi
}

cmd_status() {
  remote 'echo "service: $(systemctl is-active rover)"
    echo "last event: $(journalctl -u rover -o cat -n 1 --no-pager)"
    echo "last start: $(journalctl -u rover -o cat --no-pager | grep "\"event\": \"start\"" | tail -n 1)"
    echo "last deploy: $(journalctl -t rover-deploy -o cat --no-pager | tail -n 1)"'
}

cmd_stop() {
  # The running service holds the pins, so rover-stop alone fails "GPIO busy". Stop the service first (its ExecStopPost
  # runs rover-stop once the pins are free; a no-op if it is not running), then run rover-stop for the not-running case.
  remote sudo systemctl stop rover
  remote sudo rover-stop
  echo "motors stopped (all pins low); rover.service stopped, deploy or 'sudo systemctl start rover' to resume" >&2
}

# feed <left> <right> <seconds> <final>: resend every 100 ms (the deadman coasts after 300 ms); final=1 ends with "0 0"
feed() {
  remote sudo python3 - "$1" "$2" "$3" "$4" <<'PY'
import socket, sys, time
left, right, secs, final = sys.argv[1:5]
s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
end = time.monotonic() + float(secs)
try:
    while time.monotonic() < end:
        s.sendto(f"{left} {right}".encode(), "/run/rover/drive.sock")
        time.sleep(0.1)
finally:
    if final == "1":
        s.sendto(b"0 0", "/run/rover/drive.sock")
PY
}

# mode: the service runs the mode while no person drives, and ends it itself at the deadline (max 120 s),
# so a dropped ssh never leaves it running; pad input, Back or `mode idle` end it sooner. It moves the
# wheels: stand only.
cmd_mode() {
  [ $# = 2 ] || usage
  [[ "$1" =~ ^[a-z]+$ ]] && [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge 1 ] && [ "$2" -le 120 ] || usage
  remote sudo python3 - "$1" "$2" <<'PY'
import socket, sys, time
name, secs = sys.argv[1], int(sys.argv[2])
s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
s.sendto(f"mode {name} {secs}".encode(), "/run/rover/drive.sock")
try:
    time.sleep(secs)
finally:
    s.sendto(b"mode idle", "/run/rover/drive.sock")
PY
}

# drive ends with "0 0" and leaves rover.service running, so the pad works afterwards; the deadman
# would coast the motors 300 ms after the last command anyway. `tools/bench stop` stops everything.
cmd_drive() {
  [ $# = 3 ] || usage
  feed "$1" "$2" "$3" 1
}

# The C920 is found by name; BENCH_CAMERA_INPUT overrides the ffmpeg input args (e.g. a synthetic lavfi source)
camera_input() {
  if [ -n "${BENCH_CAMERA_INPUT:-}" ]; then CAM=($BENCH_CAMERA_INPUT); return 0; fi
  local devs=(/dev/v4l/by-id/*C920*-index0)
  if [ ! -e "${devs[0]}" ]; then
    if [ $DRY = 1 ]; then
      echo "device glob /dev/v4l/by-id/*C920*-index0: no match" >&2
      devs=('/dev/v4l/by-id/<C920>-index0')
    else
      echo "no C920 at /dev/v4l/by-id/*C920*-index0 (is the camera on this machine?)" >&2; exit 1
    fi
  else
    [ $DRY = 1 ] && echo "device glob /dev/v4l/by-id/*C920*-index0: ${devs[0]}" >&2
  fi
  CAM=(-f v4l2 -video_size 1280x720 -i "${devs[0]}")
}

stamp() { date +%Y%m%d-%H%M%S; }

cmd_snap() {
  [ $# = 0 ] || usage
  camera_input
  out="$ROOT/.bench/snaps/$(stamp).jpg"
  run mkdir -p "$(dirname "$out")"
  # skip the first frames: the C920 needs a moment for auto exposure
  run ffmpeg -nostdin -loglevel error -y "${CAM[@]}" -vf select='gte(n\,10)' -frames:v 1 -update 1 "$out"
  echo "$out"
}

cmd_clip() {
  [ $# = 1 ] && [[ $1 =~ ^[0-9]+$ ]] && [ "$1" -gt 0 ] || usage
  secs=$1
  camera_input
  base="$ROOT/.bench/clips/$(stamp)"
  run mkdir -p "$(dirname "$base")"
  run ffmpeg -nostdin -loglevel error -y "${CAM[@]}" -t "$secs" -c:v libx264 -preset ultrafast -pix_fmt yuv420p "$base.mp4"
  # 8 frames spread over the clip, 4x2 grid
  run ffmpeg -nostdin -loglevel error -y -i "$base.mp4" -vf "fps=8/$secs,scale=320:-1,tile=4x2" -frames:v 1 -update 1 "$base.jpg"
  echo "$base.mp4"
  echo "$base.jpg"
}

# check-stops: the stop paths on the real robot, on its stand (wheels off the ground). Speed 0.5, each drive <= 2 s.
# Every step prints "pass: ..." or "fail: ..."; the exit trap stops the motors however the run ends.
FAILED=0
step() { # step <name> <exit-status>
  if [ "$2" = 0 ]; then echo "pass: $1"; else echo "fail: $1"; FAILED=1; fi
}

now_remote() { [ $DRY = 1 ] && { echo "<pi time>"; return 0; }; remote date '+%Y-%m-%d\ %H:%M:%S'; }
# the service journal and the rover-stop journal since a Pi timestamp
journal() { remote "journalctl --since '$1' -o cat --no-pager _SYSTEMD_UNIT=rover.service + SYSLOG_IDENTIFIER=rover-stop"; }

start_service() {
  [ $DRY = 1 ] && { remote sudo systemctl start rover; return 0; }
  remote sudo systemctl start rover
  for _ in $(seq 1 10); do
    [ "$(remote systemctl is-active rover)" = active ] && return 0
    sleep 1
  done
  return 1
}

cmd_check_stops() {
  [ $# = 0 ] || usage
  trap 'rc=$?; trap - EXIT; echo "stopping motors" >&2; cmd_stop || echo "WARNING: stop failed, cut motor power" >&2; [ $FAILED = 0 ] || rc=1; exit $rc' EXIT
  local mark log rc clip_pid

  echo "== 1. snap before"
  if [ $DRY = 1 ]; then cmd_snap; else cmd_snap >/dev/null && step "snap before" 0 || step "snap before" 1; fi

  echo "== 2. drive both sides forward 0.5 for 2 s, with a 4 s clip"
  start_service
  mark=$(now_remote)
  if [ $DRY = 1 ]; then
    echo "+ (background) tools/bench clip 4"; feed 0.5 0.5 2 1
  else
    ( cmd_clip 4 >.bench/check-stops-clip.txt ) &
    clip_pid=$!
    sleep 1.5   # the clip's first frames are camera warm-up
    feed 0.5 0.5 2 1
    wait $clip_pid
    cat .bench/check-stops-clip.txt
    cmd_snap
  fi
  sleep 0.5
  log=$(journal "$mark")
  if [ $DRY = 1 ]; then echo "skip: check drive events in log (dry-run)"; else
    rc=0; { echo "$log" | grep -q '"event": "drive", "left": 0.5, "right": 0.5' && echo "$log" | grep -q '"event": "deadman_stop"'; } || rc=$?
    step "log has drive 0.5 0.5 then the stop" $rc
  fi

  echo "== 3. drive, stop sending, deadman within 300 ms"
  start_service
  mark=$(now_remote)
  feed 0.5 0.5 1 0
  sleep 1
  log=$(journal "$mark")
  if [ $DRY = 1 ]; then echo "skip: check deadman timing in log (dry-run)"; else
    # last drive event to deadman_stop: 300 ms deadman plus one 20 ms tick and jitter, so <= 0.32 s
    rc=0
    echo "$log" | "$PYTHON" -c '
import json, sys
ev = [json.loads(l) for l in sys.stdin if l.startswith("{")]
d = [e["t"] for e in ev if e["event"] == "drive" and e["left"] == 0.5]
s = [e["t"] for e in ev if e["event"] == "deadman_stop" and d and e["t"] >= d[-1]]
gap = s[0] - d[-1] if d and s else None
print("deadman gap: %s s" % ("none" if gap is None else "%.3f" % gap))
sys.exit(0 if gap is not None and gap <= 0.32 else 1)' || rc=$?
    step "deadman stop within 300 ms of the last command" $rc
  fi

  echo "== 4. drive, kill -9 the service, stop script runs"
  start_service
  mark=$(now_remote)
  feed 0.5 0.5 0.5 0
  remote sudo systemctl kill --kill-whom=main -s KILL rover
  sleep 2
  log=$(journal "$mark")
  if [ $DRY = 1 ]; then echo "skip: check rover-stop in log (dry-run)"; else
    rc=0; echo "$log" | grep -q 'motor pins low (coast)' || rc=$?
    step "rover-stop ran after kill -9 (motor pins low)" $rc
  fi

  echo "== 5. drive, then tools/bench stop"
  start_service
  mark=$(now_remote)
  feed 0.5 0.5 1 0
  cmd_stop
  log=$(journal "$mark")
  if [ $DRY = 1 ]; then echo "skip: check stop in log (dry-run)"; else
    rc=0; echo "$log" | grep -q 'motor pins low (coast)' || rc=$?
    step "bench stop: rover-stop logged, motor pins low" $rc
    rc=0; [ "$(remote systemctl is-active rover || true)" != active ] || rc=1
    step "bench stop: service not running" $rc
  fi

  [ $DRY = 1 ] && { echo "check-stops: dry run, nothing executed or checked"; return 0; }
  [ $FAILED = 0 ] && echo "check-stops: all steps pass (stand only, wheels off the ground)" || echo "check-stops: FAILED"
  return $FAILED
}

# pad-check: runs on the Pi with the service's venv; reads the pad without grabbing it, so rover.service keeps running
cmd_pad_check() {
  [ $# = 0 ] || usage
  remote /home/rover/rover/.venv/bin/python - <<'PY'
import json, select, subprocess, time
try:
    import evdev
except ImportError:
    raise SystemExit("python-evdev missing on the Pi: sudo apt install python3-evdev")
print("== evdev devices")
devs = [evdev.InputDevice(p) for p in evdev.list_devices()]
for d in devs:
    print(f"  {d.path}  {d.name!r}")
pads = [d for d in devs if "xbox 360" in d.name.lower() or "x-box 360" in d.name.lower()]
if not pads:
    raise SystemExit("blocked: no Xbox/X-Box 360 device (is the receiver plugged in and the pad on?)")
pad = pads[0]
print(f"== reading {pad.path} for 20 s: move sticks, trigger, press Start and Back")
j = subprocess.Popen(["journalctl", "-f", "-n", "0", "-o", "cat", "--no-pager", "-u", "rover"],
                     stdout=subprocess.PIPE, text=True)
t0 = time.monotonic()
while time.monotonic() - t0 < 20:
    ready, _, _ = select.select([pad.fd, j.stdout], [], [], 0.5)
    t = time.monotonic() - t0
    if pad.fd in ready:
        try:
            for ev in pad.read():
                if ev.type == evdev.ecodes.EV_ABS:
                    name = evdev.ecodes.bytype[ev.type].get(ev.code, ev.code)
                    print(f"{t:6.2f} ABS {name if isinstance(name, str) else name[0]} {ev.value}")
                elif ev.type == evdev.ecodes.EV_KEY:
                    name = evdev.ecodes.bytype[ev.type].get(ev.code, ev.code)
                    print(f"{t:6.2f} KEY {name if isinstance(name, str) else name[0]} {ev.value}")
        except OSError:
            print(f"{t:6.2f} pad unplugged")
            break
    if j.stdout in ready:
        line = j.stdout.readline()
        if '"mode_change"' in line:
            print(f"{t:6.2f} {line.strip()}")
j.terminate()
print("== done")
PY
}

# ping-check: rover/ping.py plus a probe, sent over ssh and run with the Pi's system python (gpiod)
cmd_ping_check() {
  secs=${1:-10}
  [[ "$secs" =~ ^[0-9]+$ ]] || usage
  { cat "$ROOT/rover/ping.py"; cat <<'PY'

import statistics, subprocess, sys
secs = int(sys.argv[1])
try:
    p = GpiodPing()
except OSError as e:
    print(f"GPIO {GPIO} is busy ({e}): rover.service owns the ping. Its status page:")
    subprocess.run(["curl", "-s", "--max-time", "2", "http://localhost:8080/state"])
    sys.exit(0)
print(f"== PING))) on GPIO {GPIO} (BOARD 16), one ping every 40 ms for {secs} s")
end, echoes = time.monotonic() + secs, []
while time.monotonic() < end:
    t0 = time.monotonic()
    if not p.trigger():
        print("pin high before trigger: echo still running or stuck high")
        time.sleep(0.04)
        continue
    e = None
    while e is None:  # the probe may wait; the tick loop never does
        time.sleep(0.0005)
        e = p.poll()
    echoes.append(e)
    if len(echoes) % 5 == 1:
        d = f"{e.distance * 100:6.1f} cm" if e.distance is not None else f"no reading ({e.error})"
        print(f"{e.time - echoes[0].time:6.2f} s  {d}  flip {e.flip_us:.0f} us")
    time.sleep(max(0.0, 0.04 - (time.monotonic() - t0)))
p.close()
ok = [e.distance for e in echoes if e.distance is not None]
errs = {}
for e in echoes:
    if e.error:
        errs[e.error] = errs.get(e.error, 0) + 1
flips = sorted(e.flip_us for e in echoes)
print(f"== {len(echoes)} pings, {len(ok)} readings, errors {errs or 'none'}")
if ok:
    print(f"   distance cm: min {min(ok)*100:.1f}  median {statistics.median(ok)*100:.1f}  max {max(ok)*100:.1f}")
print(f"   flip us: median {statistics.median(flips):.0f}  max {flips[-1]:.0f}  (must stay well under the 750 us hold-off)")
PY
  } | remote python3 - "$secs"
}

# servo-check: rover/servo.py plus a probe; the servo only, no wheels
cmd_servo_check() {
  [ $# = 0 ] || usage
  { cat "$ROOT/rover/servo.py"; cat <<'PY'

import sys
try:
    s = LgpioServo()
except Exception as e:
    print(f"servo GPIO busy or unavailable ({e}): rover.service may own it")
    sys.exit(1)
for a in (AHEAD, MIN_ANGLE, AHEAD, MAX_ANGLE, AHEAD):
    print(f"angle {a:5.1f}  pulse {pulse_us(a)} us")
    s.move(a)
    time.sleep(0.8)
s.close()
print("== done: the servo should have looked ahead, right or left, ahead, the other way, ahead")
PY
  } | remote python3 -
}

# scan-check: a temporary copy of rover/ and the probe on the Pi; never touches rover.service or the motors
cmd_scan_check() {
  [ $# = 0 ] || usage
  tar -C "$ROOT" -cz rover/__init__.py rover/ping.py rover/servo.py rover/scanner.py tools/probes/scan_check.py \
    | remote 'd=$(mktemp -d) && tar -xz -C "$d" && cd "$d" && python3 -m tools.probes.scan_check; rc=$?; rm -rf "$d"; exit $rc'
}

# loop-check: the service's loop with gpiozero's mock pins for the motors (the wheels cannot move), the real
# ping, servo and status page (port 8081), its own drive socket; prints /state and the key events
cmd_loop_check() {
  secs=${1:-15}
  [[ "$secs" =~ ^[0-9]+$ ]] && [ "$secs" -ge 6 ] || usage
  [ $DRY = 1 ] && { echo "+ copy rover/ to a temp dir on the Pi; run python3 -m rover.main for $secs s with mock motor pins"; return 0; }
  d=$(remote mktemp -d)
  tar -C "$ROOT" -cz rover | remote "tar -xz -C $d"
  remote "cd $d && (GPIOZERO_PIN_FACTORY=mock GPIOZERO_MOCK_PIN_CLASS=mockpwmpin ROVER_DRIVE_SOCKET=$d/drive.sock \
      ROVER_STATUS_PORT=8081 ROVER_COMMIT=loop-check timeout $secs python3 -m rover.main > $d/events.log 2>&1 &) ; \
    sleep $((secs - 3)); echo '== /state'; curl -s --max-time 2 localhost:8081/state; echo; sleep 4; \
    echo '== events'; grep -E '\"(start|health|obstacle_limit|fault|tick_overrun|mode_change)\"' $d/events.log | tail -n 15; rm -rf $d"
}

[ $# -ge 1 ] || usage
c=$1; shift
case $c in
  deploy|logs|status|stop|drive|mode|snap|clip) "cmd_$c" "$@" ;;
  pad-check) cmd_pad_check "$@" ;;
  ping-check) cmd_ping_check "$@" ;;
  servo-check) cmd_servo_check "$@" ;;
  scan-check) cmd_scan_check "$@" ;;
  loop-check) cmd_loop_check "$@" ;;
  check-stops) cmd_check_stops "$@" ;;
  *) usage ;;
esac
