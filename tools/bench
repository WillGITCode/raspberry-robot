#!/bin/bash
# Bench tool: deploy to the Pi, read its logs, show status, stop, drive. Host is the ssh alias rover-bench.
set -euo pipefail
HOST=rover-bench
REMOTE=rover-bench
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
LOCK="$ROOT/.bench/deploy.lock"
PYTHON=${BENCH_PYTHON:-$ROOT/.venv/bin/python}
[ -x "$PYTHON" ] || PYTHON=python3

usage() {
  cat <<'USAGE'
usage: tools/bench [--dry-run] <command>   (--dry-run prints the commands, runs nothing)
  deploy                          pytest, lock, push HEAD, wait for rover.service, print the commit
  logs [--since 2m] [--follow-for 10s]   rover.service and deploy events, bounded
  status                          service state, deployed commit, who deployed
  stop                            run rover-stop on the Pi (every motor pin low)
  drive <left> <right> <seconds>  feed the drive input for <seconds>, then stop
  snap                            JPEG from the desktop C920 to .bench/snaps/<time>.jpg, prints the path
  clip <seconds>                  MP4 plus a contact-sheet JPEG of its frames, prints both paths
USAGE
  exit 2
}

DRY=0
if [ "${1:-}" = --dry-run ]; then DRY=1; shift; fi

# --dry-run prints each command instead of running it
run() { if [ $DRY = 1 ]; then echo "+ $*"; else "$@"; fi; }
remote() { run ssh "$HOST" "$@"; }

cmd_deploy() {
  run "$PYTHON" -m pytest -q "$ROOT"
  if [ $DRY = 1 ]; then
    echo "+ flock -n $LOCK"
    echo "+ git -C $ROOT push $REMOTE HEAD:refs/heads/main"
    echo "+ (up to 30x) ssh $HOST systemctl is-active rover; ssh $HOST journalctl -u rover -o cat -n 20 --no-pager | grep '\"commit\": \"<HEAD>\"'"
    return 0
  fi
  mkdir -p "$(dirname "$LOCK")"
  exec 9>"$LOCK"
  flock -n 9 || { echo "another deploy holds $LOCK" >&2; exit 1; }
  commit=$(git -C "$ROOT" rev-parse HEAD)
  # the hook on the Pi deploys pushes to refs/heads/main
  git -C "$ROOT" push "$REMOTE" HEAD:refs/heads/main
  for _ in $(seq 1 30); do
    if [ "$(remote systemctl is-active rover)" = active ] &&
       remote journalctl -u rover -o cat -n 20 --no-pager | grep -q "\"commit\": \"$commit\""; then
      echo "active, commit $commit"
      return 0
    fi
    sleep 1
  done
  echo "rover.service not active on $commit after 30 s" >&2
  remote systemctl status rover --no-pager >&2 || true
  exit 1
}

cmd_logs() {
  since=2m follow=
  while [ $# -gt 0 ]; do
    case $1 in
      --since) since=$2; shift 2 ;;
      --follow-for) follow=$2; shift 2 ;;
      *) usage ;;
    esac
  done
  if [ -n "$follow" ]; then
    # bounded stream: the Pi-side timeout ends it
    remote timeout "$follow" journalctl -f --since "-$since" -o cat --no-pager _SYSTEMD_UNIT=rover.service + SYSLOG_IDENTIFIER=rover-deploy || [ $? = 124 ]
  else
    remote journalctl --since "-$since" -o cat --no-pager _SYSTEMD_UNIT=rover.service + SYSLOG_IDENTIFIER=rover-deploy
  fi
}

cmd_status() {
  remote 'echo "service: $(systemctl is-active rover)"
    echo "last event: $(journalctl -u rover -o cat -n 1 --no-pager)"
    echo "last start: $(journalctl -u rover -o cat --no-pager | grep "\"event\": \"start\"" | tail -n 1)"
    echo "last deploy: $(journalctl -t rover-deploy -o cat --no-pager | tail -n 1)"'
}

cmd_stop() {
  # rover-stop cannot claim pins the running service holds ("GPIO busy"); stopping the service runs it as ExecStopPost
  if ! remote sudo rover-stop 2>/dev/null; then
    remote sudo systemctl stop rover
    remote sudo rover-stop
    echo "rover.service stopped; deploy or 'sudo systemctl start rover' to resume" >&2
  fi
  echo "motors stopped (all pins low)"
}

cmd_drive() {
  [ $# = 3 ] || usage
  left=$1 right=$2 secs=$3
  # resend every 100 ms (the deadman coasts after 300 ms), then stop
  remote sudo python3 - "$left" "$right" "$secs" <<'PY'
import socket, sys, time
left, right, secs = sys.argv[1:4]
s = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM)
end = time.monotonic() + float(secs)
try:
    while time.monotonic() < end:
        s.sendto(f"{left} {right}".encode(), "/run/rover/drive.sock")
        time.sleep(0.1)
finally:
    s.sendto(b"0 0", "/run/rover/drive.sock")
PY
  cmd_stop
}

# The C920 is found by name; BENCH_CAMERA_INPUT overrides the ffmpeg input args (e.g. a synthetic lavfi source)
camera_input() {
  if [ -n "${BENCH_CAMERA_INPUT:-}" ]; then CAM=($BENCH_CAMERA_INPUT); return 0; fi
  local devs=(/dev/v4l/by-id/*C920*-index0)
  if [ ! -e "${devs[0]}" ]; then
    if [ $DRY = 1 ]; then
      echo "device glob /dev/v4l/by-id/*C920*-index0: no match" >&2
      devs=('/dev/v4l/by-id/<C920>-index0')
    else
      echo "no C920 at /dev/v4l/by-id/*C920*-index0 (is the camera on this machine?)" >&2; exit 1
    fi
  else
    [ $DRY = 1 ] && echo "device glob /dev/v4l/by-id/*C920*-index0: ${devs[0]}" >&2
  fi
  CAM=(-f v4l2 -video_size 1280x720 -i "${devs[0]}")
}

stamp() { date +%Y%m%d-%H%M%S; }

cmd_snap() {
  [ $# = 0 ] || usage
  camera_input
  out="$ROOT/.bench/snaps/$(stamp).jpg"
  run mkdir -p "$(dirname "$out")"
  # skip the first frames: the C920 needs a moment for auto exposure
  run ffmpeg -nostdin -loglevel error -y "${CAM[@]}" -vf select='gte(n\,10)' -frames:v 1 -update 1 "$out"
  echo "$out"
}

cmd_clip() {
  [ $# = 1 ] && [[ $1 =~ ^[0-9]+$ ]] && [ "$1" -gt 0 ] || usage
  secs=$1
  camera_input
  base="$ROOT/.bench/clips/$(stamp)"
  run mkdir -p "$(dirname "$base")"
  run ffmpeg -nostdin -loglevel error -y "${CAM[@]}" -t "$secs" -c:v libx264 -preset ultrafast -pix_fmt yuv420p "$base.mp4"
  # 8 frames spread over the clip, 4x2 grid
  run ffmpeg -nostdin -loglevel error -y -i "$base.mp4" -vf "fps=8/$secs,scale=320:-1,tile=4x2" -frames:v 1 -update 1 "$base.jpg"
  echo "$base.mp4"
  echo "$base.jpg"
}

[ $# -ge 1 ] || usage
c=$1; shift
case $c in
  deploy|logs|status|stop|drive|snap|clip) "cmd_$c" "$@" ;;
  *) usage ;;
esac
